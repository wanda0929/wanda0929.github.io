<dialog
  class="figure-viewer"
  id="figure-viewer"
  aria-labelledby="figure-viewer-title"
  aria-describedby="figure-viewer-help"
>
  <header class="figure-viewer__header">
    <h2 id="figure-viewer-title">Illustration</h2>
    <div class="figure-viewer__controls" aria-label="Image controls">
      <button type="button" data-figure-zoom="out" aria-label="Zoom out">−</button>
      <button type="button" data-figure-zoom="fit">Fit</button>
      <button type="button" data-figure-zoom="in" aria-label="Zoom in">+</button>
      <button type="button" data-figure-close autofocus>Close</button>
    </div>
    <p id="figure-viewer-help">Zoom to read the labels. Scroll to explore; press Escape to close.</p>
  </header>
  <div class="figure-viewer__viewport" tabindex="0" role="region" aria-label="Enlarged illustration">
    <img class="figure-viewer__image" alt="" />
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("#figure-viewer");
  const viewport = dialog?.querySelector<HTMLDivElement>(".figure-viewer__viewport");
  const image = dialog?.querySelector<HTMLImageElement>(".figure-viewer__image");
  const title = dialog?.querySelector<HTMLHeadingElement>("#figure-viewer-title");
  const close = dialog?.querySelector<HTMLButtonElement>("[data-figure-close]");
  const zoomIn = dialog?.querySelector<HTMLButtonElement>('[data-figure-zoom="in"]');
  const zoomOut = dialog?.querySelector<HTMLButtonElement>('[data-figure-zoom="out"]');
  const fit = dialog?.querySelector<HTMLButtonElement>('[data-figure-zoom="fit"]');

  if (dialog && viewport && image && title && close && zoomIn && zoomOut && fit) {
    let trigger: HTMLAnchorElement | null = null;
    let zoom = 1;
    let imageWidth = 1440;
    let imageHeight = 1080;
    let fittedWidth = 1000;

    function measureFit() {
      if (!viewport) return;
      const availableWidth = Math.max(120, viewport.clientWidth - 24);
      const availableHeight = Math.max(120, viewport.clientHeight - 24);
      fittedWidth = Math.min(availableWidth, availableHeight * imageWidth / imageHeight, imageWidth);
    }

    function draw() {
      if (!image || !zoomOut || !zoomIn) return;
      image.style.width = `${Math.round(fittedWidth * zoom)}px`;
      zoomOut.disabled = zoom <= 1;
      zoomIn.disabled = zoom >= 4;
    }

    function changeZoom(nextZoom: number) {
      if (!viewport) return;
      const previousWidth = fittedWidth * zoom;
      const centerX = viewport.scrollLeft + viewport.clientWidth / 2;
      const centerY = viewport.scrollTop + viewport.clientHeight / 2;
      zoom = Math.max(1, Math.min(4, nextZoom));
      draw();
      const ratio = fittedWidth * zoom / previousWidth;
      viewport.scrollLeft = centerX * ratio - viewport.clientWidth / 2;
      viewport.scrollTop = centerY * ratio - viewport.clientHeight / 2;
    }

    document.querySelectorAll<HTMLAnchorElement>(".article-body .figure-link").forEach((link) => {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const source = link.querySelector<HTMLImageElement>("img");
        if (!source || typeof dialog.showModal !== "function") return;
        event.preventDefault();
        trigger = link;
        imageWidth = source.naturalWidth || Number(source.getAttribute("width")) || 1440;
        imageHeight = source.naturalHeight || Number(source.getAttribute("height")) || 1080;
        image.src = link.href;
        image.alt = source.alt;
        const number = link.closest("figure")?.id.match(/^figure-(\d+)$/)?.[1];
        title.textContent = number ? `Figure ${number}` : "Illustration";
        zoom = 1;
        dialog.showModal();
        document.documentElement.classList.add("figure-viewer-open");
        measureFit();
        draw();
        viewport.scrollTo({ left: 0, top: 0 });
        close.focus({ preventScroll: true });
      });
    });

    zoomIn.addEventListener("click", () => changeZoom(zoom * 1.5));
    zoomOut.addEventListener("click", () => changeZoom(zoom / 1.5));
    fit.addEventListener("click", () => {
      zoom = 1;
      measureFit();
      draw();
      viewport.scrollTo({ left: 0, top: 0 });
    });
    close.addEventListener("click", () => dialog.close());
    dialog.addEventListener("close", () => {
      document.documentElement.classList.remove("figure-viewer-open");
      if (trigger?.isConnected) trigger.focus({ preventScroll: true });
    });
    dialog.addEventListener("click", (event) => {
      if (event.target !== dialog) return;
      const bounds = dialog.getBoundingClientRect();
      if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) dialog.close();
    });
    window.addEventListener("resize", () => {
      if (!dialog.open) return;
      measureFit();
      draw();
    });
  }
</script>
