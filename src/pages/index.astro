---
import BaseLayout from "../layouts/BaseLayout.astro";
import { researchNotes } from "../data/notes";
import { selectedWork } from "../data/work";
const latestNotes = researchNotes.slice(0, 3);
---
<BaseLayout>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">NEUTRAL ATOMS · QUANTUM CONTROL</p>
      <h1>From atomic physics to <em>quantum computing.</em></h1>
      <p class="hero-description">I'm Wanda. I work on quantum control and neutral-atom quantum computing, focusing on Rydberg interactions, quantum gates, and pulse design. Here I share my research projects and computational tools, along with notes on the physics, methods, and papers I am exploring.</p>
      <div class="hero-actions">
        <a class="text-link" href="/work/">Explore selected work <span aria-hidden="true">↗</span></a>
        <a class="quiet-link" href="/notes/">Read the notes <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="hero-art" role="img" aria-label="Abstract illustration of an optical tweezer array">
      <div class="art-caption">ATOMIC SYSTEMS / QUANTUM CONTROL</div>
      <div class="atom-field" aria-hidden="true">
        {Array.from({ length: 5 }).map((_, row) => Array.from({ length: 7 }).map((__, col) => <span class:list={["atom", (row + col) % 3 === 0 ? "atom-bright" : ""]} style={`--x:${col};--y:${row}`}></span>))}
      </div>
      <div class="laser-line" aria-hidden="true"></div>
      <div class="art-bottom"><span>INTERACTIONS</span><span>GATES &amp; PULSES</span></div>
    </div>
  </section>

  <section class="work-section" aria-labelledby="work-heading">
    <div class="section-heading">
      <div><p class="eyebrow">PAPERS &amp; PROJECTS</p><h2 id="work-heading">Selected work</h2></div>
      <a class="text-link" href="/work/">View all work <span aria-hidden="true">→</span></a>
    </div>
    <p class="section-description">Research contributions in quantum control and neutral-atom quantum computing.</p>
    <div class="work-preview-grid">
      {selectedWork.slice(0, 4).map((item, index) => <article class="work-card">
        <div class="work-card-topline"><span>0{index + 1}</span><span>{item.type} · {item.year}</span></div>
        <h3><a href={`/work/#${item.id}`}>{item.title}</a></h3>
        <p>{item.description}</p>
        <a class="work-card-link" href={item.href} target="_blank" rel="noreferrer">{item.linkLabel} <span aria-hidden="true">↗</span></a>
      </article>)}
    </div>
  </section>

  <section class="writing-section notes-preview" aria-labelledby="notes-heading">
    <div class="section-heading">
      <div><p class="eyebrow">THE NOTEBOOK</p><h2 id="notes-heading">Research notes</h2></div>
      <a class="text-link" href="/notes/">All notes <span aria-hidden="true">→</span></a>
    </div>
    <p class="section-description">Explanations, reading notes, and methods from the questions I work through.</p>
    <div class="article-list compact">
      {latestNotes.map((item, index) => <article class="article-row">
        <span class="article-index">0{index + 1}</span>
        <div class="article-row-content">
          <p class="eyebrow">{item.category}</p>
          <h3>{item.href ? <a href={item.href}>{item.title}</a> : item.title}</h3>
          <p>{item.description}</p>
        </div>
        <span class="article-status">{item.status ?? item.date}</span>
      </article>)}
    </div>
  </section>
</BaseLayout>
