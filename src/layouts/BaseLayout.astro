---
import "../styles/global.css";
const {
  title = "Wanda's Research Journal",
  description = "Research notes, papers, and projects by Wanda on quantum control, neutral-atom quantum computing, and computational methods.",
  canonical
} = Astro.props;
const pageTitle = title === "Wanda's Research Journal" ? title : `${title} — Wanda's Research Journal`;
const navigation = [
  { href: "/notes/", label: "Research Notes" },
  { href: "/work/", label: "Selected Work" },
  { href: "/about/", label: "About" }
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f7f2" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical ?? Astro.url.href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical ?? Astro.url.href} />
    <meta property="og:site_name" content="Wanda's Research Journal" />
    <link rel="alternate" type="application/rss+xml" title="Wanda's Research Journal" href="/rss.xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label="Wanda's Research Journal home">
          <span class="wordmark-mark">W</span>
          <span>Wanda's <em>Research Journal</em></span>
        </a>
        <nav aria-label="Main navigation">
          {navigation.map(({ href, label }) => <a href={href} aria-current={Astro.url.pathname.startsWith(href) ? "page" : undefined}>{label}</a>)}
        </nav>
      </header>
      <main id="main">
        <slot />
      </main>
      <footer class="site-footer">
        <div>
          <span class="footer-name">Wanda's Research Journal</span>
          <span class="footer-note">Neutral atoms, quantum control, and a researcher's notebook.</span>
        </div>
        <div class="footer-links">
          <a href="https://github.com/wanda0929" target="_blank" rel="noreferrer">GitHub ↗</a>
          <a href="/rss.xml">RSS</a>
        </div>
        <p class="copyright">© {new Date().getFullYear()} Wanda. Written with curiosity.</p>
      </footer>
    </div>
  </body>
</html>
